#cloud-config
# Node of the s1d1 community instance, as a Terraform templatefile() (Ubuntu 24.04, aarch64 or x86_64).
# Template variables: tunnel_token, community_token, desired_url. Apart from the three lines that carry one,
# the files below are verbatim copies of files of node/, with the dollar-brace sequences doubled for Terraform;
# node/test/test_cloud_init.sh fails when a copy drifts from its file.
#
# The tokens end up in /opt/s1d1/.env (mode 0600, root) and in cloud-init's own copy of the user data
# (/var/lib/cloud/instance/user-data.txt, root only). They are never printed by update.sh.
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - docker.io          # Ubuntu's own package: no third-party apt source to trust
  - docker-compose-v2  # the `docker compose` plugin
write_files:
  - path: /opt/s1d1/compose.yaml
    owner: root:root
    permissions: "0644"
    content: |
      # A s1d1 community node: tantive (the router) behind a Cloudflare Tunnel. No port is published: the only traffic that
      # reaches tantive is what `cloudflared` forwards (ingress `http://tantive:8788`, set on the tunnel), and the only
      # traffic that leaves is the tunnel and the capture sender (https://s1d1.qoo.gy/ingest).
      #
      # Generic: the same file runs on the Oracle A1 instance and on a homelab. The images (TANTIVE_IMAGE,
      # CLOUDFLARED_IMAGE) are written into .env by update.sh from desired.env; the secrets (TUNNEL_TOKEN,
      # COMMUNITY_TOKEN) are put there by cloud-init or by hand. See example.env.
      name: s1d1

      x-logging: &logging
        driver: json-file
        options:
          max-size: "10m"
          max-file: "3"

      services:
        # The capture folder is a named volume, created root-owned; tantive runs as uid 10001 and needs to write in it.
        # This one-shot step uses the tantive image itself (no extra image to pin) and only gets the CHOWN capability.
        capture-init:
          image: $${TANTIVE_IMAGE:?set TANTIVE_IMAGE (update.sh writes it)}
          user: "0:0"
          entrypoint: ["chown", "10001:10001", "/capture"]
          volumes:
            - capture:/capture
          read_only: true
          cap_drop: [ALL]
          cap_add: [CHOWN]
          security_opt:
            - no-new-privileges:true
          restart: "no"
          logging: *logging

        tantive:
          image: $${TANTIVE_IMAGE:?set TANTIVE_IMAGE (update.sh writes it)}
          restart: unless-stopped
          depends_on:
            capture-init:
              condition: service_completed_successfully
          environment:
            S1D1_FORMATS: systemone,decisions,chat,classify,predict
            S1D1_ROOT_PATH: /api
            S1D1_CAPTURE_DIR: /capture
            S1D1_CAPTURE_RETENTION_DAYS: "2"
            S1D1_CAPTURE_SEND: "1"
            S1D1_CAPTURE_TOKEN: $${COMMUNITY_TOKEN:?set COMMUNITY_TOKEN}
            S1D1_TERMS_VERSION: v1
          volumes:
            - capture:/capture
          # no `ports:` on purpose
          read_only: true
          tmpfs:
            - /tmp
          cap_drop: [ALL]
          security_opt:
            - no-new-privileges:true
          healthcheck:
            # no curl in the image: urllib does the probe (/ready: the weights are loaded, as in tantive's own compose.yaml)
            test: ["CMD", "python", "-c", "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8788/ready').status == 200 else 1)"]
            interval: 30s
            timeout: 5s
            start_period: 60s
            retries: 3
          logging: *logging

        cloudflared:
          image: $${CLOUDFLARED_IMAGE:?set CLOUDFLARED_IMAGE (update.sh writes it)}
          restart: unless-stopped
          command: tunnel --no-autoupdate run
          environment:
            TUNNEL_TOKEN: $${TUNNEL_TOKEN:?set TUNNEL_TOKEN}
          depends_on:
            - tantive
          read_only: true
          cap_drop: [ALL]
          security_opt:
            - no-new-privileges:true
          logging: *logging

      volumes:
        capture:
  - path: /opt/s1d1/cosign.pub
    owner: root:root
    permissions: "0644"
    content: |
      -----BEGIN PUBLIC KEY-----
      MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE8oXrVMvoYJ8x1/cYPgiDCL5kKzlT
      MATN6VGTLZELrcXbAmtIVZ35jQR4+3K53ONt3waPAm0iTCYnKkd4WHNSyA==
      -----END PUBLIC KEY-----
  - path: /opt/s1d1/update.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      # update.sh <env file> <desired url>
      #
      # Pull-based update of a node. It downloads node/desired.env from the repository (the images, by digest), checks the
      # cosign signature of every tantive image that changed, and only then rewrites the images in <env file> and runs
      # `docker compose up -d`. An image whose signature does not verify is never started.
      #
      # Exit codes: 0 up to date or updated; 1 refused or failed to apply (the env file is left as it was);
      #             2 the desired file could not be downloaded.
      #
      # Trust: the tantive images (VERIFIED_KEYS) are verified with cosign, keyless, against the identity of the `build`
      # workflow of github.com/scombat/s1d1-tantive (the invocation of s1d1-tantive/docs/verify.md). cloudflared is not
      # signed by us: it is only checked to be pinned by digest, and it changes only through a digest change in
      # node/desired.env, which goes through review of a pull request on this repository.
      #
      # The secrets (TUNNEL_TOKEN, COMMUNITY_TOKEN) live in <env file> only. They are never read, printed or logged here.
      set -eu
      umask 077

      VERIFIED_KEYS="TANTIVE_IMAGE"
      IDENTITY_REGEXP='^https://github.com/scombat/s1d1-tantive/\.github/workflows/build\.yml@refs/tags/v'
      OIDC_ISSUER='https://token.actions.githubusercontent.com'

      if [ $# -ne 2 ]; then
        echo "usage: update.sh <env file> <desired url>" >&2
        exit 1
      fi
      ENV_FILE=$1
      DESIRED_URL=$2
      NODE_DIR=$(dirname "$ENV_FILE")
      COMPOSE_FILE=$${S1D1_COMPOSE_FILE:-$NODE_DIR/compose.yaml}

      WORK=$(mktemp -d "$NODE_DIR/.update.XXXXXX")
      trap 'rm -rf "$WORK"' EXIT INT TERM
      DESIRED=$WORK/desired.env
      CHANGES=$WORK/changes.env
      : >"$CHANGES"

      # ---- 1. download the desired images ------------------------------------------------------------------------------
      if ! curl -fsSL --proto '=https' --tlsv1.2 --retry 2 --max-time 30 -o "$DESIRED" "$DESIRED_URL"; then
        echo "update: cannot download $DESIRED_URL" >&2
        exit 2
      fi

      # ---- 2. parse it: only NAME_IMAGE=repo[:tag]@sha256:<64 hex> lines, comments and blank lines ---------------------
      current_value() { # current_value <KEY>: the value in the env file, empty when absent
        [ -f "$ENV_FILE" ] || return 0
        sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
      }

      while IFS= read -r line || [ -n "$line" ]; do
        case $line in
          '' | '#'*) continue ;;
        esac
        key=$${line%%=*}
        value=$${line#*=}
        case $key in
          '' | *[!A-Z0-9_]* | [0-9]*)
            echo "update: refused, not a KEY=value line: $key" >&2
            exit 1
            ;;
          *_IMAGE) ;;
          *)
            echo "update: refused, desired.env may only set *_IMAGE keys, found $key" >&2
            exit 1
            ;;
        esac
        case $value in
          *@sha256:*) ;;
          *)
            echo "update: refused, $key is not pinned by digest (@sha256:...)" >&2
            exit 1
            ;;
        esac
        # repository[:tag]@sha256:<64 lowercase hex>, no quotes, no spaces
        if ! printf '%s\n' "$value" | grep -Eq '^[a-z0-9][a-z0-9./_-]*(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$'; then
          echo "update: refused, $key is not a valid image reference with a sha256 digest" >&2
          exit 1
        fi
        if [ "$value" != "$(current_value "$key")" ]; then
          printf '%s=%s\n' "$key" "$value" >>"$CHANGES"
        fi
      done <"$DESIRED"

      if [ ! -s "$CHANGES" ]; then
        echo "update: up to date"
        exit 0
      fi

      # ---- 3. verify every changed tantive image before touching anything ----------------------------------------------
      while IFS= read -r change; do
        key=$${change%%=*}
        image=$${change#*=}
        case " $VERIFIED_KEYS " in
          *" $key "*)
            echo "update: verifying $image"
            if ! cosign verify "$image" \
              --certificate-identity-regexp "$IDENTITY_REGEXP" \
              --certificate-oidc-issuer "$OIDC_ISSUER" >/dev/null; then
              echo "update: refused, the signature of $image does not verify" >&2
              exit 1
            fi
            ;;
          *) echo "update: $key pinned by digest ($image), not cosign-verified" ;;
        esac
      done <"$CHANGES"

      # ---- 4. write the env atomically, then start ---------------------------------------------------------------------
      NEW=$(mktemp "$NODE_DIR/.env.XXXXXX")
      BACKUP=$WORK/env.previous
      if [ -f "$ENV_FILE" ]; then
        cp -p "$ENV_FILE" "$BACKUP"
        awk 'NR == FNR { k = $0; sub(/=.*/, "", k); new[k] = 1; next }
             { k = $0; sub(/=.*/, "", k); if (!(k in new)) print }' "$CHANGES" "$ENV_FILE" >"$NEW"
      else
        : >"$BACKUP"
      fi
      cat "$CHANGES" >>"$NEW"
      chmod 600 "$NEW"
      mv "$NEW" "$ENV_FILE"

      if ! docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" up -d --remove-orphans; then
        echo "update: docker compose up failed, previous images restored in $ENV_FILE" >&2
        cp -p "$BACKUP" "$WORK/restore"
        mv "$WORK/restore" "$ENV_FILE"
        exit 1
      fi

      # old images are left untagged by the digest change: free the disk, never fail on it
      docker image prune -f >/dev/null 2>&1 || true
      echo "update: done"
  - path: /opt/s1d1/.env
    owner: root:root
    permissions: "0600"
    content: |
      TUNNEL_TOKEN=${tunnel_token}
      COMMUNITY_TOKEN=${community_token}
  - path: /etc/systemd/system/s1d1-update.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=s1d1 node: verified pull update
      Wants=network-online.target
      After=network-online.target docker.service

      [Service]
      Type=oneshot
      TimeoutStartSec=10min
      ExecStart=/opt/s1d1/update.sh /opt/s1d1/.env ${desired_url}
  - path: /etc/systemd/system/s1d1-update.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=s1d1 node: verified pull update, every 15 minutes

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=15min
      RandomizedDelaySec=60

      [Install]
      WantedBy=timers.target
runcmd:
  # cosign, pinned by version, with the sha256 of the release binary checked before it is installed
  - |
    set -eu
    case "$(uname -m)" in
      aarch64) arch=arm64; sum=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2 ;;
      x86_64) arch=amd64; sum=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa ;;
      *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
    esac
    tmp=$(mktemp)
    curl -fsSL -o "$tmp" "https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-linux-$arch"
    echo "$sum  $tmp" | sha256sum -c -
    install -m 0755 "$tmp" /usr/local/bin/cosign
    rm -f "$tmp"
  - systemctl enable --now docker
  - systemctl daemon-reload
  # first update now (blocks until done); a failure is retried by the timer, which starts 2 minutes after boot
  - systemctl start s1d1-update.service || true
  - systemctl enable --now s1d1-update.timer
